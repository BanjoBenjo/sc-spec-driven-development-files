{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "AgentClinic home shell built with TanStack Start",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dev-server": "node ./scripts/validate-dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "npm run test:run && npm run typecheck && npm run build && npm run test:dev-server"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.64",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "private": true
}
